---
// Gerado a partir de: confraternizacoes.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import WhatsAppModal from '../components/layout/WhatsAppModal.astro';
import '../styles/confraternizacoes.css';

const title = "Restaurante para Confraternizações de Empresas em São Paulo | Aretha Kitchen";
const description = "Proporcione à sua equipe uma confraternização inesquecível em Moema. Espaço exclusivo com alta gastronomia internacional, bar integrado e drinks sofisticados.";
const canonical = "https://eventos.arethakitchen.com.br/confraternizacoes/";
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/images/og-confraternizacoes.jpg"
>
  <Fragment slot="head">
    <!-- FontAwesome para os Ícones -->
    <link 
      rel="stylesheet" 
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" 
      integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" 
      crossorigin="anonymous" 
      referrerpolicy="no-referrer" 
    />
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <!-- Swiper Slider CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  </Fragment>

  <!-- Hero Section -->
  <header class="conf-hero" style="background-image: url('/src/assets/images/Bar-integrado-scaled.webp');" id="hero">
    <div class="container conf-hero-content">
      <Img 
        src="ArethaSoulKitchen_Logo.png" 
        alt="Aretha Soul Kitchen Logo" 
        width={220} 
        height={50} 
        class="conf-hero-logo" 
        priority 
      />
      <h1 class="conf-hero-title">RESTAURANTE PARA<br />CONFRATERNIZAÇÕES<br />EM SÃO PAULO</h1>
      <p class="conf-hero-text">
        O Aretha Soul Kitchen é o espaço ideal para eventos intimistas:<br />reuniões empresariais, confraternizações, encontros de mentoria, entre outros.
      </p>
      <a href="#contato" class="btn btn-primary">Solicitar Orçamento</a>
    </div>
  </header>

  <!-- Experience & Spaces Section Wrapper -->
  <section class="conf-experience-spaces-section">
    
    <!-- Experience Card Box -->
    <div class="container">
      <div class="conf-experience-card">
        <Img 
          src="Papagaio.png" 
          alt="Papagaio decorativo" 
          width={336} 
          height={228} 
          class="conf-floating-bird" 
        />
        <div class="conf-experience-grid">
          
          <div class="conf-experience-content">
            <h2 class="conf-experience-title">MUITO MAIS QUE<br />UM ESPAÇO</h2>
            <p class="conf-experience-text">
              O Aretha Soul Kitchen proporciona aos eventos corporativos e confraternizações uma experiência imersiva em diferentes culturas e tradições, por meio da gastronomia e musicalidade. Localizado no coração de Moema, em São Paulo, nossa equipe altamente treinada cuida de cada detalhe com capricho e agilidade, garantindo que cada evento ou festa da sua empresa seja completa.
            </p>
            <a href="#contato" class="btn btn-primary">Solicitar Orçamento</a>
          </div>

          <div class="conf-experience-media">
            <Img 
              src="sobre_aretha.webp" 
              alt="Espaço de Confraternização Aretha" 
              width={480} 
              height={735} 
              class="conf-experience-img" 
            />
          </div>

        </div>
      </div>
    </div>

    <!-- Spaces Section Nested -->
    <div class="conf-spaces" id="espacos">
      <div class="container" style="position: relative;">
        <h2 class="conf-spaces-title">Restaurante para eventos, confraternizações<br />empresariais.</h2>
        
        <div class="conf-spaces-grid">
          
          <!-- Térreo -->
          <article class="space-card">
            <div class="space-card-img-wrapper">
              <Img src="Terreo-scaled.webp" alt="Espaço Térreo Aretha" width={400} height={350} class="space-card-img" />
              <h3 class="space-card-title">TÉRREO</h3>
            </div>
            <div class="space-card-content">
              <p class="space-card-text">Acomoda até 30 pessoas sentadas ou 70 pessoas no formato coquetel.</p>
            </div>
          </article>

          <!-- Bar Integrado -->
          <article class="space-card">
            <div class="space-card-img-wrapper">
              <Img src="Bar-integrado-scaled.webp" alt="Bar Integrado Aretha" width={400} height={350} class="space-card-img" />
              <h3 class="space-card-title">BAR INTEGRADO</h3>
            </div>
            <div class="space-card-content">
              <p class="space-card-text">Ambiente descontraído, perfeito para apreciar drinks deliciosos.</p>
            </div>
          </article>

          <!-- Mezanino -->
          <article class="space-card">
            <div class="space-card-img-wrapper">
              <Img src="Mezanino-scaled.webp" alt="Mezanino Aretha" width={400} height={350} class="space-card-img" />
              <h3 class="space-card-title">MEZANINO</h3>
            </div>
            <div class="space-card-content">
              <p class="space-card-text">Acomoda até 50 pessoas.</p>
            </div>
          </article>

        </div>
        
        <Img src="Folha.png" alt="Folha decorativa" width={425} height={289} class="conf-floating-leaf" />
      </div>
    </div>

  </section>

  <!-- Exclusives Section -->
  <section class="conf-exclusives">
    <div class="conf-exclusives-bg" style="background-image: url('/src/assets/images/Mao.png');"></div>
    <div class="container">
      <h2 class="conf-exclusives-title">EXCLUSIVIDADES QUE FAZEM<br />TODA A DIFERENÇA A SUA<br />CONFRATERNIZAÇÃO</h2>
      
      <div class="conf-exclusives-grid">
        
        <div class="exclusive-item">
          <Img src="localizacao.webp" alt="Localização" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Localização<br>Privilegiada</span>
        </div>

        <div class="exclusive-item">
          <Img src="Cadeira.webp" alt="Mobiliário" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Mobiliário<br>Completo</span>
        </div>

        <div class="exclusive-item">
          <Img src="Nota-musica.webp" alt="Música" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Música<br>ambiente</span>
        </div>

        <div class="exclusive-item">
          <Img src="TV.webp" alt="TV" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Televisão</span>
        </div>

        <div class="exclusive-item">
          <Img src="Projetor.webp" alt="Projetor" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Projetor e<br>Telão</span>
        </div>

        <div class="exclusive-item">
          <Img src="Microfone.webp" alt="Microfone" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Microfone</span>
        </div>

        <div class="exclusive-item">
          <Img src="Deficiente.webp" alt="Acessibilidade" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Banheiro<br>acessível</span>
        </div>

        <div class="exclusive-item">
          <Img src="Staff.webp" alt="Equipe" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Equipe de Staff<br>qualificada</span>
        </div>

      </div>
    </div>
  </section>

  <!-- Gastronomy Section -->
  <section class="conf-gastronomy" style="background-image: url('/src/assets/images/bg-gastronomia-corporativos.png');" id="gastronomia">
    <div class="container conf-gastronomy-grid">
      
      <!-- Carousel Swiper (Agora à Esquerda) -->
      <div class="gastronomy-swiper-container">
        <div class="gastronomy-swiper swiper">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              <Img src="gastronomia-4.webp" alt="Gastronomia Aretha" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="gastronomia-3.webp" alt="Testes de Menu" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="gastronomia-2.webp" alt="Gastronomia Otimizada" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="gastronomia-1.webp" alt="Prato Fino 1" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="gastronomia-6.webp" alt="Drinks finos" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="gastronomia-5.webp" alt="Finger Foods" width={500} height={750} />
            </div>
          </div>
          <!-- Setas de Navegação -->
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      </div>

      <!-- Texto (Agora à Direita) -->
      <div class="conf-gastronomy-content">
        <h2 class="conf-gastronomy-title">GASTRONOMIA QUE<br />ATRAVESSA<br />FRONTEIRAS</h2>
        <p class="conf-gastronomy-text">
          Nosso restaurante para eventos e confraternizações oferece uma gastronomia internacional. Nossa culinária combina ingredientes, temperos e técnicas artesanais de diversas partes do mundo, proporcionando aos apreciadores uma experiência de sabores únicos e inovadores. Valorizamos a gastronomia de diferentes culturas, sem impor rótulos. Nosso menu é diversificado, oferecendo desde finger foods até sobremesas surpreendentes.
        </p>
      </div>

      <!-- Limão Decorativo -->
      <Img src="Limao.png" alt="Limão decorativo" width={300} height={204} class="conf-floating-lemon" />
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="conf-gallery">
    <div class="container">
      <h2 class="conf-gallery-title">Descubra os detalhes que o Aretha pode proporcionar</h2>
      
      <div class="conf-gallery-layout">
        <div class="gallery-col gallery-col-left">
          <div class="gallery-item"><Img src="galeria-6.webp" alt="Detalhe do Espaço" width={416} height={250} class="gallery-item-img" /></div>
          <div class="gallery-item"><Img src="galeria-5-scaled.webp" alt="Mesa posta decorada" width={416} height={555} class="gallery-item-img" /></div>
        </div>
        <div class="gallery-col gallery-col-right">
          <div class="gallery-row gallery-row-top">
            <div class="gallery-item col-small"><Img src="galeria-3.webp" alt="Detalhe Gourmet" width={229} height={350} class="gallery-item-img" /></div>
            <div class="gallery-item col-large"><Img src="galeria-2.webp" alt="Salão Aretha" width={454} height={350} class="gallery-item-img" /></div>
          </div>
          <div class="gallery-row gallery-row-bottom">
            <div class="gallery-item"><Img src="galeria-4.webp" alt="Brinde corporativo" width={342} height={457} class="gallery-item-img" /></div>
            <div class="gallery-item"><Img src="galeria-1-scaled.webp" alt="Ambiente externo" width={342} height={457} class="gallery-item-img" /></div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Contact Section -->
  <section class="conf-contact" style="background-image: url('/src/assets/images/bg-form-corporativos.webp');" id="contato">
    <div class="container conf-contact-grid">
      
      <div class="conf-contact-info">
        <div class="conf-contact-text-group">
          <h2 class="conf-contact-title">PRONTO PARA UMA EXPERIÊNCIA CULTURAL?</h2>
          <Img src="Origami.png" alt="Origami" width={370} height={252} class="conf-contact-logo-origami" />
          <p class="conf-contact-text">Preencha o formulário para receber nosso contato.</p>
        </div>
        <Img src="ArethaSoulKitchen_Logo.png" alt="Aretha Soul Kitchen Logo" width={240} height={54} class="conf-contact-logo" />
      </div>

      <div class="conf-form-wrapper">
        <LeadForm
          formId="confrat-lead-form"
          project={config.project_slug}
          submitUrl={config.forms['lead-form'].webhooks[0]}
          redirectUrl={config.forms['lead-form'].redirect_on_success}
          submitText="Enviar Solicitação"
          honeypot
          fields={[
            { name: 'empresa', type: 'text', placeholder: 'Nome da Empresa', required: false },
            { name: 'nome', type: 'text', placeholder: 'Seu Nome *', required: true },
            { name: 'telefone', type: 'tel', placeholder: 'WhatsApp / Telefone *', required: true },
            { name: 'email', type: 'email', placeholder: 'E-mail *', required: true },
            { name: 'tipo', type: 'select', required: true, options: [
              { value: '', label: 'Tipo de evento: (Selecione) *', disabled: true, selected: true },
              { value: 'Confraternização corporativa', label: 'Confraternização Corporativa' },
              { value: 'Confraternização social', label: 'Confraternização Social' },
              { value: 'Outros', label: 'Outros' }
            ] },
            { name: 'data', type: 'text', placeholder: 'Data sugerida *', required: true, id: 'conf-date-picker' },
            { name: 'convidados', type: 'number', placeholder: 'Nº aproximado de pessoas *', required: true },
            { name: 'mensagem', type: 'textarea', placeholder: 'Descreva os detalhes ou desejos para a sua confraternização...', required: false }
          ]}
        />
      </div>

    </div>
    <Img src="Cantora.png" alt="Cantora flutuante decorativa" width={382} height={260} class="conf-floating-singer" />
  </section>

  <!-- Footer Section -->
  <footer class="conf-footer">
    <div class="container conf-footer-grid">
      <p class="conf-footer-copy">
        Copyright © 2026 Aretha Soul Kitchen – Todos os direitos reservados
      </p>
      <Img src="ArethaSoulKitchen_Logo.png" alt="Aretha Soul Kitchen Logo" width={150} height={34} class="conf-footer-logo" />
      <div class="conf-footer-dev">
        <span>Desenvolvido por:</span>
        <a href="https://dmove.com.br/?utm_source=arethakitchencombr" target="_blank" rel="noopener" class="conf-footer-dev-link">
          <Img src="logo-dmove.png" alt="Dmove Marketing" width={100} height={24} class="conf-footer-dmove-logo" />
        </a>
      </div>
    </div>
  </footer>

  <!-- Modal Inteligente do WhatsApp -->
  <WhatsAppModal 
    eventTypes={[
      { value: 'Confraternização corporativa', label: 'Confraternização corporativa' },
      { value: 'Confraternização social', label: 'Confraternização social' },
      { value: 'Outros', label: 'Outros' }
    ]}
  />

  <Fragment slot="scripts">
    <!-- Flatpickr JS -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- Swiper Slider JS -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Inicializa o Swiper Carousel
        if (window.Swiper) {
          new Swiper('.gastronomy-swiper', {
            loop: true,
            autoplay: {
              delay: 5000,
              disableOnInteraction: false,
            },
            navigation: {
              nextEl: '.swiper-button-next',
              prevEl: '.swiper-button-prev',
            },
          });
        }

        // Inicializa o Flatpickr para o campo de data
        const dateInput = document.getElementById('conf-date-picker');
        if (dateInput && window.flatpickr) {
          window.flatpickr(dateInput, {
            disableMobile: true,
            dateFormat: "d/m/Y",
            locale: {
              weekdays: { shorthand: ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"], longhand: ["Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira", "Sábado"] },
              months: { shorthand: ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"], longhand: ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"] },
              firstDayOfWeek: 1,
              rangeSeparator: " até ",
              ordinal: () => "º"
            }
          });
        }
      });
    </script>
  </Fragment>

</Base>
