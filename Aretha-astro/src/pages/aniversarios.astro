---
// Gerado a partir de: aniversarios.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import WhatsAppModal from '../components/layout/WhatsAppModal.astro';
import '../styles/aniversarios.css';
import bgHero from '../assets/images/bg-hero-corporativos.webp';
import bgGastro from '../assets/images/bg-gastronomia-corporativos.png';
import bgForm from '../assets/images/bg-form-corporativos.webp';

const title = "Restaurante para Festas de Aniversário em Moema, São Paulo | Aretha Kitchen";
const description = "Comemore seu aniversário em um espaço descontraído com uma experiência gastronômica internacional de tirar o fôlego. Localizado no coração de Moema, com infraestrutura completa.";
const canonical = "https://eventos.arethakitchen.com.br/aniversarios/";
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/images/og-aniversarios.jpg"
>
  <Fragment slot="head">
    <!-- FontAwesome para os Ícones -->
    <link 
      rel="stylesheet" 
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" 
      integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" 
      crossorigin="anonymous" 
      referrerpolicy="no-referrer" 
    />
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <!-- Swiper Slider CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  </Fragment>

  <!-- Hero Section -->
  <header class="ani-hero" style={`background-image: url('${bgHero.src}');`} id="hero">
    <div class="container ani-hero-content">
      <Img 
        src="ArethaSoulKitchen_Logo.png" 
        alt="Aretha Soul Kitchen Logo" 
        width={220} 
        height={50} 
        class="ani-hero-logo" 
        priority 
      />
      <h1 class="ani-hero-title">O seu aniversário merece uma comemoração especial</h1>
      <p class="ani-hero-text">
        Espaço descontraído e uma experiência gastronômica única, pensados para surpreender você e seus convidados no dia mais especial do ano.
      </p>
      <a href="#contato" class="btn btn-primary">Solicitar Orçamento</a>
    </div>
  </header>

  <!-- Experience & Spaces Section Wrapper -->
  <section class="ani-experience-spaces-section">
    
    <!-- Experience Card Box -->
    <div class="container">
      <div class="ani-experience-card">
        <Img 
          src="Papagaio.png" 
          alt="Papagaio decorativo" 
          width={336} 
          height={228} 
          class="ani-floating-bird" 
        />
        <div class="ani-experience-grid">
          
          <div class="ani-experience-content">
            <h2 class="ani-experience-title">MUITO MAIS DO QUE UM ESPAÇO</h2>
            <p class="ani-experience-text">
              O Aretha Soul Kitchen proporciona às celebrações uma experiência imersiva em diferentes culturas e tradições, por meio da gastronomia e musicalidade. Localizado no coração de Moema, em São Paulo, nossa equipe de profissionais cuida de cada detalhe com capricho e agilidade, garantindo que seu aniversário seja memorável.
            </p>
            <a href="#contato" class="btn btn-primary">Solicitar Orçamento</a>
          </div>

          <div class="ani-experience-media">
            <Img 
              src="sobre_aretha.webp" 
              alt="Comemoração no Aretha" 
              width={480} 
              height={735} 
              class="ani-experience-img" 
            />
          </div>

        </div>
      </div>
    </div>

    <!-- Spaces Section Nested -->
    <div class="ani-spaces" id="espacos">
      <div class="container" style="position: relative;">
        <h2 class="ani-spaces-title">DE ENCONTROS INTIMISTAS ÀS GRANDES CONFRATERNIZAÇÕES</h2>
        
        <div class="ani-spaces-grid">
          
          <!-- Térreo -->
          <article class="space-card">
            <div class="space-card-img-wrapper">
              <Img src="Terreo-scaled.webp" alt="Salão Térreo Aretha" width={400} height={240} class="space-card-img" />
              <h3 class="space-card-title">TÉRREO</h3>
            </div>
            <div class="space-card-content">
              <p class="space-card-text">Acomoda até 30 pessoas sentadas ou 70 pessoas no formato coquetel.</p>
            </div>
          </article>

          <!-- Bar Integrado -->
          <article class="space-card">
            <div class="space-card-img-wrapper">
              <Img src="Bar-integrado-scaled.webp" alt="Bar Integrado Aretha" width={400} height={240} class="space-card-img" />
              <h3 class="space-card-title">BAR INTEGRADO</h3>
            </div>
            <div class="space-card-content">
              <p class="space-card-text">Ambiente descontraído, perfeito para apreciar drinks deliciosos e artesanais.</p>
            </div>
          </article>

          <!-- Mezanino -->
          <article class="space-card">
            <div class="space-card-img-wrapper">
              <Img src="Mezanino-scaled.webp" alt="Mezanino do Aretha" width={400} height={240} class="space-card-img" />
              <h3 class="space-card-title">MEZANINO</h3>
            </div>
            <div class="space-card-content">
              <p class="space-card-text">Acomoda até 50 pessoas de forma reservada e exclusiva.</p>
            </div>
          </article>

        </div>
        
        <Img src="Folha.png" alt="Folha decorativa" width={425} height={289} class="ani-floating-leaf" />
      </div>
    </div>

  </section>

  <!-- Exclusives Section -->
  <section class="ani-exclusives">
    <div class="ani-exclusives-bg" style="background-image: url('/images/Mao.png');"></div>
    <div class="container">
      <h2 class="ani-exclusives-title">Curta sua festa sem preocupações</h2>
      
      <div class="ani-exclusives-grid">
        
        <div class="exclusive-item">
          <Img src="localizacao.webp" alt="Localização" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Localização<br>Privilegiada</span>
        </div>

        <div class="exclusive-item">
          <Img src="Microfone.webp" alt="Microfone" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Microfone para<br>Homenagens</span>
        </div>

        <div class="exclusive-item">
          <Img src="Cadeira.webp" alt="Mobiliário" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Mobiliário<br>Completo</span>
        </div>

        <div class="exclusive-item">
          <Img src="speaker-1.png" alt="Som" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Caixas acústicas<br>e mesa de som</span>
        </div>

        <div class="exclusive-item">
          <Img src="TV.webp" alt="Televisão" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Televisão e<br>Notebook</span>
        </div>

        <div class="exclusive-item">
          <Img src="Projetor.webp" alt="Projetor" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Projetor e<br>Telão</span>
        </div>

        <div class="exclusive-item">
          <Img src="air-conditioning_1.png" alt="Climatização" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Espaço climatizado<br>(ar quente e frio)</span>
        </div>

        <div class="exclusive-item">
          <Img src="Deficiente.webp" alt="Acessibilidade" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Banheiro com<br>Acessibilidade</span>
        </div>

        <div class="exclusive-item">
          <Img src="Staff.webp" alt="Equipe" width={180} height={180} class="exclusive-icon" />
          <span class="exclusive-caption">Equipe de Staff<br>Qualificada</span>
        </div>

      </div>
    </div>
  </section>

  <!-- Gastronomy Section -->
  <section class="ani-gastronomy" style={`background-image: url('${bgGastro.src}');`} id="gastronomia">
    <div class="container ani-gastronomy-grid">
      
      <!-- Swiper Widget Wrapper with Railroad Background -->
      <div class="gastronomy-swiper-container">
        <div class="gastronomy-swiper swiper">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              <Img src="gastronomia-4.webp" alt="Gastronomia Finger Foods" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="gastronomia-3.webp" alt="Prato refinado Aretha" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="gastronomia-6.webp" alt="Bebidas e Coquetéis" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="imagens-gastronomia-aretha-1-scaled.jpeg" alt="Gastronomia Salão" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="imagens-gastronomia-aretha-2-scaled.jpeg" alt="Gastronomia Buffet" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="imagens-gastronomia-aretha-3-scaled.jpeg" alt="Bolo de Festa" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="imagens-gastronomia-aretha-4-scaled.jpeg" alt="Menu Especial" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="imagens-gastronomia-aretha-5-scaled.jpeg" alt="Prato Autoral" width={500} height={750} />
            </div>
            <div class="swiper-slide">
              <Img src="imagens-gastronomia-aretha-6-scaled.jpeg" alt="Bebidas e Vinhos" width={500} height={750} />
            </div>
          </div>
          <!-- Setas de Navegação -->
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      </div>

      <div class="ani-gastronomy-content">
        <h2 class="ani-gastronomy-title">GASTRONOMIA QUE<br />ATRAVESSA<br />FRONTEIRAS</h2>
        <p class="ani-gastronomy-text">Nosso restaurante para eventos oferece uma gastronomia internacional de excelência. Nossa culinária combina ingredientes selecionados, temperos marcantes e técnicas artesanais, proporcionando aos seus convidados uma experiência de sabores memoráveis e inovadores.</p>
        <p class="ani-gastronomy-text">
          Valorizamos a gastronomia de diferentes culturas, sem impor rótulos. Nosso menu é extremamente diversificado, oferecendo desde finger foods sofisticados até sobremesas deliciosas e pratos autorais memoráveis.
        </p>
      </div>

      <!-- Limão Decorativo -->
      <Img src="Limao.png" alt="Limão decorativo" width={300} height={204} class="ani-floating-lemon" />
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="ani-gallery">
    <div class="container">
      <h2 class="ani-gallery-title">Explore a atmosfera que transforma sua comemoração</h2>
      
      <div class="ani-gallery-layout">
        <div class="gallery-col gallery-col-left">
          <div class="gallery-item"><Img src="galeria-6.webp" alt="Detalhe do Espaço" width={416} height={250} class="gallery-item-img" /></div>
          <div class="gallery-item"><Img src="galeria-5-scaled.webp" alt="Mesa posta decorada" width={416} height={555} class="gallery-item-img" /></div>
        </div>
        <div class="gallery-col gallery-col-right">
          <div class="gallery-row gallery-row-top">
            <div class="gallery-item col-small"><Img src="galeria-3.webp" alt="Detalhe Gourmet" width={229} height={350} class="gallery-item-img" /></div>
            <div class="gallery-item col-large"><Img src="galeria-2.webp" alt="Salão Aretha" width={454} height={350} class="gallery-item-img" /></div>
          </div>
          <div class="gallery-row gallery-row-bottom">
            <div class="gallery-item"><Img src="galeria-4.webp" alt="Brinde corporativo" width={342} height={457} class="gallery-item-img" /></div>
            <div class="gallery-item"><Img src="galeria-1-scaled.webp" alt="Ambiente externo" width={342} height={457} class="gallery-item-img" /></div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="ani-testimonials">
    <div class="container">
      <h2 class="ani-testimonials-title">Depoimentos que provam nossa excelência</h2>
      
      <div class="meus-depoimentos-container">
        
        <!-- Theo Moraes -->
        <div class="testimonial-card">
          <Img src="pexels-photo-614810.jpeg" alt="Foto de Theo Moraes" width={80} height={80} class="avatar" />
          <div class="rating">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
          </div>
          <h3 class="name">Theo Moraes</h3>
          <p class="text-content">Adorei minha experiência no Aretha! Comida maravilhosa e atendimento nota 1000!</p>
        </div>

        <!-- Júlia Bussab Fonseca -->
        <div class="testimonial-card">
          <Img src="pexels-photo-774909.jpeg" alt="Foto de Júlia Bussab Fonseca" width={80} height={80} class="avatar" />
          <div class="rating">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
          </div>
          <h3 class="name">Júlia Bussab Fonseca</h3>
          <p class="text-content">Eu confiei no Aretha Soul Kitchen um dos dias mais especiais da minha vida: meu casamento. E não poderia ter feito melhor escolha! A Melissa me passou confiança desde o início, pela simpatia e cuidado que ela teve em cuidar de cada detalhe! A comida estava impecável, o serviço foi muito especial, com atendentes extremamente atenciosos e simpáticos, e o ambiente perfeito: do jeito que eu queria! Tive zero stress, curti a noite toda, e fiquei com memórias incríveis.</p>
          <button class="read-more-btn">Ver mais</button>
        </div>

        <!-- Amanda -->
        <div class="testimonial-card">
          <Img src="pexels-photo-733872.jpeg" alt="Foto de Amanda" width={80} height={80} class="avatar" />
          <div class="rating">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
          </div>
          <h3 class="name">Amanda</h3>
          <p class="text-content">Eles amaram! tanto que falaram que o próximo jantar vai ser difícil de ser melhor</p>
        </div>

        <!-- Ana K -->
        <div class="testimonial-card">
          <Img src="pexels-photo-1239291.jpeg" alt="Foto de Ana K" width={80} height={80} class="avatar" />
          <div class="rating">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
          </div>
          <h3 class="name">Ana K</h3>
          <p class="text-content">Eu frequento o Aretha faz anos e sou muito apaixonada pelo cuidado e a qualidade dos pratos! A Mel, dona do Aretha, nitidamente coloca todo amor dela nesse restaurante. Indico muito o Sanduíche de Filé de Peixe com melaço de laranja, os Risottos e as sobremesas!! Até comemorei meu aniversário no Aretha já e foi maravilhoso!</p>
          <button class="read-more-btn">Ver mais</button>
        </div>

      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="ani-contact" style={`background-image: url('${bgForm.src}');`} id="contato">
    <div class="container ani-contact-grid">
      
      <div class="ani-contact-info">
        <div class="ani-contact-text-group">
          <h2 class="ani-contact-title">Pronto para festejar?</h2>
          <Img src="Origami.png" alt="Origami" width={370} height={252} class="ani-contact-logo-origami" />
          <p class="ani-contact-text">Preencha o formulário para receber nosso contato.</p>
        </div>
        <Img src="ArethaSoulKitchen_Logo.png" alt="Aretha Soul Kitchen Logo" width={240} height={54} class="ani-contact-logo" />
      </div>

      <div class="ani-form-wrapper">
        <LeadForm
          formId="aniv-lead-form"
          project={config.project_slug}
          submitUrl={config.forms['lead-form'].webhooks[0]}
          redirectUrl={config.forms['lead-form'].redirect_on_success}
          submitText="Enviar Solicitação"
          honeypot
          fields={[
            { name: 'nome', type: 'text', placeholder: 'Seu Nome *', required: true },
            { name: 'telefone', type: 'tel', placeholder: 'WhatsApp / Telefone *', required: true },
            { name: 'email', type: 'email', placeholder: 'E-mail *', required: true },
            { name: 'tipo', type: 'select', required: true, options: [
              { value: '', label: 'Tipo de evento: (Selecione) *', disabled: true },
              { value: 'Aniversário', label: 'Aniversário', selected: true },
              { value: 'Aniversário debutante', label: 'Aniversário Debutante' },
              { value: 'Bodas', label: 'Bodas' },
              { value: 'Casamento', label: 'Casamento' },
              { value: 'Confraternização social', label: 'Confraternização Social' },
              { value: 'Outros', label: 'Outros' }
            ] },
            { name: 'data', type: 'text', placeholder: 'Data do evento *', required: true, id: 'ani-date-picker' },
            { name: 'convidados', type: 'number', placeholder: 'Nº aproximado de pessoas *', required: true },
            { name: 'mensagem', type: 'textarea', placeholder: 'Detalhes adicionais ou desejos especiais...', required: false }
          ]}
        />
      </div>

    </div>
    <Img src="Cantora.png" alt="Cantora decorativa" width={382} height={260} class="ani-contact-singer" />
  </section>

  <!-- Footer Section -->
  <footer class="ani-footer">
    <div class="container ani-footer-grid">
      <p class="ani-footer-copy">
        Copyright © 2026 Aretha Soul Kitchen – Todos os direitos reservados
      </p>
      <Img src="ArethaSoulKitchen_Logo.png" alt="Aretha Soul Kitchen Logo" width={150} height={34} class="ani-footer-logo" />
      <div class="ani-footer-dev">
        <span>Desenvolvido por:</span>
        <a href="https://dmove.com.br/?utm_source=arethakitchencombr" target="_blank" rel="noopener" class="ani-footer-dev-link">
          <Img src="logo-dmove.png" alt="Dmove Marketing" width={100} height={24} class="ani-footer-dmove-logo" />
        </a>
      </div>
    </div>
  </footer>

  <!-- Modal Inteligente do WhatsApp -->
  <WhatsAppModal 
    eventTypes={[
      { value: 'Aniversário', label: 'Aniversário' },
      { value: 'Aniversário debutante', label: 'Aniversário debutante' },
      { value: 'Bodas', label: 'Bodas' },
      { value: 'Casamento', label: 'Casamento' },
      { value: 'Outros', label: 'Outros' }
    ]}
  />

  <Fragment slot="scripts">
    <!-- Flatpickr JS -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- Swiper Slider JS -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Inicializa o Swiper Carousel
        if (window.Swiper) {
          new Swiper('.gastronomy-swiper', {
            loop: true,
            autoplay: {
              delay: 5000,
              disableOnInteraction: false,
            },
            navigation: {
              nextEl: '.swiper-button-next',
              prevEl: '.swiper-button-prev',
            },
          });
        }

        // Inicializa o Flatpickr para o campo de data
        const dateInput = document.getElementById('ani-date-picker');
        if (dateInput && window.flatpickr) {
          window.flatpickr(dateInput, {
            disableMobile: true,
            dateFormat: "d/m/Y",
            locale: {
              weekdays: { shorthand: ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"], longhand: ["Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira", "Sábado"] },
              months: { shorthand: ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"], longhand: ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"] },
              firstDayOfWeek: 1,
              rangeSeparator: " até ",
              ordinal: () => "º"
            }
          });
        }

        // Comportamento expandir/colapsar depoimentos longos
        const testimonialCards = document.querySelectorAll('.testimonial-card');
        testimonialCards.forEach(card => {
          const btn = card.querySelector('.read-more-btn');
          const content = card.querySelector('.text-content');
          if (btn && content) {
            btn.addEventListener('click', () => {
              const isExpanded = card.classList.contains('expanded');
              if (isExpanded) {
                card.classList.remove('expanded');
                btn.textContent = 'Ver mais';
              } else {
                card.classList.add('expanded');
                btn.textContent = 'Ver menos';
              }
            });
          }
        });
      });
    </script>
  </Fragment>
</Base>
